<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- New-PacKitGuid / Test-PacKitGuid: braced, UPPERCASE -->
  <xs:simpleType name="PacKitGuidType">
    <xs:restriction base="xs:string">
      <xs:pattern value="\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Get-PacKitAttributeText 'Bool' case: literal "true"/"false" only. -->
  <xs:simpleType name="PacKitBoolType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Get-PacKitAttributeText 'TimeT' case: non-negative integer, "0" when unset. -->
  <xs:simpleType name="PacKitTimeTType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Get-PacKitAttributeText 'Double' case: ('F6' invariant-culture), e.g. "0.950000". -->
  <xs:simpleType name="PacKitDoubleType">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?[0-9]+\.[0-9]{6}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="FRAGMENT">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ITEM" type="PacKitAppItemType"/>
      </xs:sequence>
      <xs:attribute name="Version" type="xs:string" fixed="23.8" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Application ITEM: attribute order per Get-PacKitSchema.App (WorkspaceApps.cpp:414-442). -->
  <xs:complexType name="PacKitAppItemType">
    <xs:sequence>
      <xs:element name="COLLECTION" type="PacKitAppCollectionType" minOccurs="2" maxOccurs="2"/>
    </xs:sequence>

    <xs:attribute name="AppId" type="PacKitGuidType" use="required"/>
    <xs:attribute name="Name" type="xs:string" use="required"/>
    <xs:attribute name="Vendor" type="xs:string" use="required"/>
    <xs:attribute name="Description" type="xs:string" use="required"/>
    <xs:attribute name="IconPath" type="xs:string" use="required"/>
    <xs:attribute name="WinGetAppScannedAt" type="PacKitTimeTType" use="required"/>
    <xs:attribute name="Unseen" type="PacKitBoolType" use="required"/>
    <xs:attribute name="OperatingSys" type="xs:string" use="required"/>
    <xs:attribute name="OperatingSysArchitecture" type="xs:string" use="required"/>
    <xs:attribute name="ReturnCodesJson" type="xs:string" use="required"/>
    <xs:attribute name="ScopeTagId" type="xs:string" use="required"/>

    <!-- DetectionRule.* attributes are free-form strings; see file-level comment. -->
    <xs:attribute name="DetectionRuleFormat" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleType" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleMsiValue" type="xs:string" use="required"/>
    <xs:attribute name="DetectionMethodScript" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleFilePath" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleFileName" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleRegKey" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleRegValue" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleFileDetectionType" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleFileOperator" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleFileValue" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleRegDetectionType" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleRegOperator" type="xs:string" use="required"/>
    <xs:attribute name="DetectionRuleRegDetectionValue" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="PacKitAppCollectionType">
    <xs:sequence>
      <xs:element name="ITEM" type="PacKitCollectionItemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="Name" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="Packages"/>
          <xs:enumeration value="IntuneAssignments"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="PacKitCollectionItemType">
    <xs:sequence>
      <!-- Present (always, even empty) only on Package ITEMs. -->
      <xs:element name="COLLECTION" type="PacKitWinGetScanResultsCollectionType" minOccurs="0"/>
    </xs:sequence>

    <!-- Packages ITEM attributes -->
    <xs:attribute name="PackageId" type="PacKitGuidType"/>
    <xs:attribute name="PackageIntuneId" type="xs:string"/>
    <xs:attribute name="CatalogPackageId" type="xs:string"/>
    <xs:attribute name="CatalogUpdateCheckedAt" type="PacKitTimeTType"/>
    <xs:attribute name="CatalogUpdateAvailable" type="PacKitBoolType"/>
    <xs:attribute name="InstallCmdLine" type="xs:string"/>
    <xs:attribute name="UninstallCmdLine" type="xs:string"/>
    <xs:attribute name="Path" type="xs:string"/>
    <xs:attribute name="SourceFolder" type="xs:string"/>
    <xs:attribute name="Type" type="xs:string"/>
    <xs:attribute name="Version" type="xs:string"/>
    <xs:attribute name="ProductCode" type="xs:string"/>
    <xs:attribute name="PackageArchitecture" type="xs:string"/>
    <xs:attribute name="IntuneDeployTime" type="xs:string"/>
    <xs:attribute name="IntuneEncryptionKey" type="xs:string"/>
    <xs:attribute name="IntuneEncryptionIV" type="xs:string"/>

    <!-- IntuneAssignments ITEM attributes -->
    <xs:attribute name="MsEntraGroupId" type="PacKitGuidType"/>
    <xs:attribute name="AssignmentType" type="xs:string"/>
    <xs:attribute name="InclusionType" type="xs:string"/>
  </xs:complexType>

  <!-- <COLLECTION Name="WinGetScanResults">0..N scan-result ITEMs</COLLECTION> -->
  <xs:complexType name="PacKitWinGetScanResultsCollectionType">
    <xs:sequence>
      <xs:element name="ITEM" type="PacKitWinGetScanResultItemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="Name" type="xs:string" fixed="WinGetScanResults" use="required"/>
  </xs:complexType>

  <!-- WinGetScanResult ITEM: attribute order per Get-PacKitSchema.WinGetScanResult (WorkspaceApps.cpp:480-483). -->
  <xs:complexType name="PacKitWinGetScanResultItemType">
    <xs:attribute name="WinGetCatalogPackageId" type="xs:string" use="required"/>
    <xs:attribute name="WinGetMatchScore" type="PacKitDoubleType" use="required"/>
    <xs:attribute name="WinGetAppVendor" type="xs:string" use="required"/>
  </xs:complexType>

</xs:schema>
